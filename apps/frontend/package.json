{
  "name": "@flowfox/frontend",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "lint": "eslint ./src && stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:fix": "eslint ./src --fix && stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@flowfox/shared": "workspace:*",
    "axios": "1.13.6",
    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.4",
    "quasar": "^2.18.6",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/vite-plugin": "^1.10.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss-html": "^1.8.1",
    "sass": "^1.100.0",
    "sass-embedded": "^1.98.0",
    "stylelint": "^17.11.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  }
}
