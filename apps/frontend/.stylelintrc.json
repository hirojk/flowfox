{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-order"],
  "rules": {
    "selector-class-pattern": null,
    "scss/at-mixin-pattern": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["deep", "global", "slotted"]
      }
    ],
    "order/properties-order": [
      "content",
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "isolation",
      "inset",
      "display",
      "flex",
      "flex-direction",
      "flex-wrap",
      "flex-shrink",
      "flex-grow",
      "grid-template-rows",
      "grid-template-columns",
      "grid-row",
      "grid-column",
      "justify-content",
      "align-items",
      "gap",
      "transform",
      "width",
      "height",
      "min-width",
      "max-width",
      "min-height",
      "max-height",
      "aspect-ratio",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "outline",
      "outline-offset",
      "border",
      "border-width",
      "border-style",
      "border-radius",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "background",
      "background-color",
      "box-shadow",
      "color",
      "font-size",
      "font-weight",
      "font-family",
      "text-align",
      "text-decoration",
      "line-height",
      "line-clamp",
      "-webkit-line-clamp",
      "-webkit-box-orient",
      "white-space",
      "z-index",
      "cursor",
      "opacity",
      "overflow",
      "overflow-x",
      "overflow-y",
      "transition",
      "animation"
    ]
  },
  "overrides": [
    {
      "files": ["**/*.vue"],
      "customSyntax": "postcss-html"
    },
    {
      "files": ["**/*.scss"],
      "customSyntax": "postcss-scss"
    }
  ]
}
