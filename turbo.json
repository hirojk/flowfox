{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_URL",
        "STAGE_PASS",
        "FRONTEND_URL",
        "ADMIN_USER",
        "ADMIN_PASS",
        "MONGODB_URI",
        "APP_ENV"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "API_URL",
        "STAGE_PASS",
        "FRONTEND_URL",
        "ADMIN_USER",
        "ADMIN_PASS",
        "MONGODB_URI",
        "APP_ENV"
      ]
    },
    "test": {
      "dependsOn": [
        "^test:unit"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "^lint:fix"
      ]
    }
  }
}