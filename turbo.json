{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "MONGODB_URI",
        "NODE_ENV",
        "ADMIN_USER",
        "ADMIN_PASS",
        "ACCESS_TOKEN_SECRET"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "MONGODB_URI",
        "NODE_ENV",
        "ADMIN_USER",
        "ADMIN_PASS",
        "ACCESS_TOKEN_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    }
  }
}
