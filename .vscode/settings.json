{
  "files.exclude": {
    "**/.turbo": true,
    "**/node_modules": true
  },
  
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, bun.lockb, .npmrc, .nvmrc, nodemon.json",
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    ".env": ".env.*",
    ".gitignore": ".gitattributes, .gitmodules",
    ".eslintrc*": ".eslintignore",
    ".prettierrc*": ".prettierignore",
    ".stylelintrc*": ".stylelintignore",
    "vite.config.*": "vitest.config.*, cypress.config.*, playwright.config.*",
    "README.md": "CHANGELOG.md, CONTRIBUTING.md, LICENSE, CODE_OF_CONDUCT.md"
  },

  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "stylelint.enable": true,
  "stylelint.validate": ["css", "scss", "vue"]
}
